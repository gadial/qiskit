ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

ARG PACKAGE_NAME=qiskit
ARG PACKAGE_VERSION=

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /work

COPY qpy_test_constraints.txt qpy_test_constraints.txt

RUN python -m pip install --upgrade pip && \
    major=${PACKAGE_VERSION%%.*} && \
    rest=${PACKAGE_VERSION#*.} && \
    minor=${rest%%[^0-9]*} && \
    if [ "$major" -gt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -ge 5 ]; }; then \
        pip install packaging "${PACKAGE_NAME}==${PACKAGE_VERSION}"; \
    else \
        pip install -c qpy_test_constraints.txt packaging "${PACKAGE_NAME}==${PACKAGE_VERSION}"; \
    fi

CMD ["python", "-c", "import qiskit; import sys; print(f'Qiskit version: {qiskit.__version__}'); print(f'Python version: {sys.version}')"]